#!/usr/bin/env python3
"""
Terraform credentials_helper for JFrog AWS IAM Role Token Exchange.

Protocol: Terraform calls `credentials_helper "jfrog" {}` which resolves to this script.
Terraform invokes: `terraform-credentials-jfrog get <host>`
- On success (host=gcewebmkt.jfrog.io): print {"token":"<access_token>"} to stdout, exit 0
- On foreign host: print {} to stdout, exit 0 (no AWS call made)
- On error: print diagnostic to stderr, exit non-zero

Uses botocore (py3-botocore) to acquire ECS task-role credentials and signs an STS
GetCallerIdentity request (SigV4), then exchanges it with JFrog's /access/api/v1/aws/token
endpoint for a short-lived access token.
"""

import json
import os
import sys
import urllib.request
import urllib.error
import time


def get_region():
    """
    Resolve AWS region in precedence order:
    1. AWS_REGION env var
    2. AWS_DEFAULT_REGION env var
    3. ECS Task Metadata v4 (AvailabilityZone stripped of last char)
    4. Fallback: us-east-1
    """
    if os.environ.get("AWS_REGION"):
        return os.environ["AWS_REGION"]
    
    if os.environ.get("AWS_DEFAULT_REGION"):
        return os.environ["AWS_DEFAULT_REGION"]
    
    # Try ECS Task Metadata v4
    metadata_uri = os.environ.get("ECS_CONTAINER_METADATA_URI_V4")
    if metadata_uri:
        try:
            url = f"{metadata_uri}/task"
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=2) as resp:
                task_metadata = json.loads(resp.read().decode())
                az = task_metadata.get("AvailabilityZone", "")
                if az:
                    # Strip last character (AZ letter) to get region
                    return az[:-1]
        except (urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError, KeyError, OSError):
            pass  # Fall through to default
    
    return "us-east-1"


def get_frozen_credentials():
    """
    Acquire ECS task-role credentials via botocore.
    Botocore automatically resolves AWS_CONTAINER_CREDENTIALS_RELATIVE_URI.
    """
    from botocore.session import Session
    session = Session()
    credentials = session.get_credentials()
    if not credentials:
        raise RuntimeError("Unable to resolve AWS credentials")
    return credentials.get_frozen_credentials()


def sign_sts_request(region, frozen_creds):
    """
    Build and sign an STS GetCallerIdentity request using SigV4.
    Returns AWSRequest with signed headers.
    """
    from botocore.auth import SigV4Auth
    from botocore.awsrequest import AWSRequest
    url = f"https://sts.{region}.amazonaws.com/"
    params = {
        "Action": "GetCallerIdentity",
        "Version": "2011-06-15"
    }
    
    req = AWSRequest(method="GET", url=url, params=params)
    SigV4Auth(frozen_creds, "sts", region).add_auth(req)
    return req


def exchange_with_jfrog(region, signed_headers):
    """
    POST signed STS request headers to JFrog's /access/api/v1/aws/token endpoint.
    Retry up to 3 times on 5xx or timeout; fail fast on 4xx.
    Returns parsed response JSON or None on failure.
    """
    url = f"https://gcewebmkt.jfrog.io/access/api/v1/aws/token?region={region}"
    
    # Prepare headers: forward all signed STS headers
    headers = dict(signed_headers)
    # Override/add required headers
    headers["Host"] = "gcewebmkt.jfrog.io"
    headers["Content-Type"] = "application/json"
    headers["X-Amz-Region-Set"] = region
    
    body = json.dumps({"expires_in": 1800}).encode("utf-8")
    
    max_retries = 3
    retry_count = 0
    
    while retry_count < max_retries:
        try:
            req = urllib.request.Request(
                url,
                data=body,
                headers=headers,
                method="POST"
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                if resp.status == 200:
                    return json.loads(resp.read().decode())
                else:
                    print(f"JFrog returned HTTP {resp.status}", file=sys.stderr)
                    return None
        except urllib.error.HTTPError as e:
            # 4xx: fail fast
            if 400 <= e.code < 500:
                print(f"JFrog returned HTTP {e.code}: {e.reason}", file=sys.stderr)
                return None
            # 5xx: retry
            retry_count += 1
            if retry_count < max_retries:
                time.sleep(0.5 * retry_count)
        except (urllib.error.URLError, OSError) as e:
            # Network error or timeout: retry
            retry_count += 1
            if retry_count < max_retries:
                time.sleep(0.5 * retry_count)
            elif isinstance(e, OSError) and "timed out" in str(e).lower():
                print(f"Timeout contacting JFrog after {max_retries} retries", file=sys.stderr)
                return None
            else:
                print(f"Network error contacting JFrog: {e}", file=sys.stderr)
                return None
    
    print(f"Failed to exchange with JFrog after {max_retries} retries", file=sys.stderr)
    return None


def main():
    # Parse argv: [prog] get <host>
    if len(sys.argv) < 3:
        print("Usage: terraform-credentials-jfrog get <host>", file=sys.stderr)
        sys.exit(1)
    
    verb = sys.argv[1]
    host = sys.argv[2]
    
    # Only support 'get'
    if verb != "get":
        print(f"Unsupported verb: {verb} (only 'get' is supported)", file=sys.stderr)
        sys.exit(1)
    
    # Only serve gcewebmkt.jfrog.io
    if host != "gcewebmkt.jfrog.io":
        print("{}")
        sys.exit(0)
    
    try:
        region = get_region()
        frozen_creds = get_frozen_credentials()
        signed_req = sign_sts_request(region, frozen_creds)
        response = exchange_with_jfrog(region, signed_req.headers)
        
        if response is None:
            sys.exit(1)
        
        # Extract access_token field
        if "access_token" not in response:
            print("JFrog response missing 'access_token' field", file=sys.stderr)
            sys.exit(1)
        
        access_token = response["access_token"]
        # Print success response to stdout
        print(json.dumps({"token": access_token}))
        sys.exit(0)
    
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
